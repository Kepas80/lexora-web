{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/((?!api|assets|favicon\\.ico|favicon\\.png|icon-192\\.png|icon-512\\.png|og-image\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml|service-worker\\.js).*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "lexoraflashcards.com" }], "destination": "https://www.lexoraflashcards.com/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    }
  ]
}
